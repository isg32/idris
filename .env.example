# Copy to .env and fill in. .env is gitignored: never commit real values.
#
# IDRIS_KEYSTORE_BASE64: base64 -w0 path/to/release-key.jks
IDRIS_KEYSTORE_BASE64=
IDRIS_KEYSTORE_PASSWORD=
# Optional: defaults to IDRIS_KEYSTORE_PASSWORD.
IDRIS_KEY_PASSWORD=
# Optional: defaults to "upload".
IDRIS_KEY_ALIAS=upload
