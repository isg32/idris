<?xml version="1.0" encoding="utf-8"?>
<!-- Resources found by name at runtime (getIdentifier), which the release
     build's resource shrinker can't see: audio_service's media controls and
     the notification icon. Without them every media session update fails
     ("You must specify an icon resource id"), so Android's notification,
     lock-screen and quick-settings player stay empty. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_notify_*" />
