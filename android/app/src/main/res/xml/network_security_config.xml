<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this phone itself: just_audio serves a track that is
     still downloading through a local proxy (CachingAudioSource), and
     Android refuses http:// by default. Everything else stays HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
